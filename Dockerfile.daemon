FROM node:20-alpine as builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++ bash

# Copy everything for build
COPY . .

# Install and build
RUN npm ci
# node-pty's Linux prebuilds target glibc, while Alpine uses musl. Rebuild only
# this native addon so other dependencies can continue using their prebuilds.
RUN npm_config_build_from_source=true npm rebuild node-pty
RUN npm run build:daemon


# Final stage: runtime
FROM node:20-alpine

WORKDIR /app

# Install runtime dependencies only
RUN apk add --no-cache python3

# Copy built artifacts from builder
COPY --from=builder /app/packages/server/dist ./packages/server/dist
COPY --from=builder /app/packages/relay/dist ./packages/relay/dist
COPY --from=builder /app/packages/highlight/dist ./packages/highlight/dist
COPY --from=builder /app/packages/cli/dist ./packages/cli/dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/server/src/server/speech/providers/local/sherpa/assets ./packages/server/src/server/speech/providers/local/sherpa/assets

# Copy package.json for runtime
COPY packages/server/package.json ./packages/server/package.json
COPY packages/relay/package.json ./packages/relay/package.json
COPY packages/highlight/package.json ./packages/highlight/package.json

# Create data directories
RUN mkdir -p /data/paseo /data/feltdb

# FeltDB and Paseo data volumes
VOLUME ["/data/paseo", "/data/feltdb"]

# Set environment variables
ENV NODE_ENV=production
ENV PASEO_HOME=/data/paseo
ENV FELTDB_PATH=/data/feltdb

# Expose daemon port
EXPOSE 6767

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const http = require('http'); http.get('http://localhost:6767/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1));" || exit 1

# Start daemon
CMD ["node", "packages/server/dist/server/server/index.js"]
